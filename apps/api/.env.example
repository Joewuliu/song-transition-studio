# Comma-separated list of frontend origins allowed to call this API (CORS).
# If unset, defaults to http://localhost:3000 — safe for local development
# with zero configuration.
#
# For a deployed frontend, set this to its real origin(s), e.g.:
# FRONTEND_ORIGINS=https://song-transition-studio.example.com
# FRONTEND_ORIGINS=https://app.example.com,https://staging.example.com
#
# Never set this to "*" — the API is served with credentials enabled,
# and a wildcard origin combined with credentials is both insecure and
# rejected by browsers.
FRONTEND_ORIGINS=http://localhost:3000
